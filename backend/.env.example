# Server Configuration
PORT=5000
NODE_ENV=development

# Snowflake Connection Configuration
# -------------------------------------------------------------
# SNOWFLAKE_ACCOUNT: Your Snowflake account locator or organization identifier.
# Formats:
#   - <account_locator>.<region_id> (e.g. xy12345.us-east-1 or xy12345.ap-southeast-1)
#   - <orgname>-<accountname> (preferred for new Snowflake accounts)
SNOWFLAKE_ACCOUNT=

# SNOWFLAKE_USERNAME: The username used to log in to Snowflake
SNOWFLAKE_USERNAME=

# SNOWFLAKE_PASSWORD: The password for the user specified above
SNOWFLAKE_PASSWORD=

# SNOWFLAKE_WAREHOUSE: (Optional) Compute warehouse name (e.g. COMPUTE_WH)
SNOWFLAKE_WAREHOUSE=

# SNOWFLAKE_DATABASE: (Optional) Database to use (e.g. PS1_DATAMIND_DB)
SNOWFLAKE_DATABASE=

# SNOWFLAKE_SCHEMA: (Optional) Schema to use (e.g. PUBLIC)
SNOWFLAKE_SCHEMA=

# SNOWFLAKE_ROLE: (Optional) Role to assume (e.g. ACCOUNTADMIN, SYSADMIN)
SNOWFLAKE_ROLE=

# Google Gemma AI Configuration
# -------------------------------------------------------------
# GEMMA_API_KEY: Your Google AI Studio API key used to access Gemma models
GEMMA_API_KEY=

# GEMMA_MODEL: Explicit Gemma model identifier (e.g. gemma-2-9b-it, gemma-2-27b-it, gemma-2-2b-it)
GEMMA_MODEL=gemma-2-9b-it
